# Copy this file to .env and fill in private values on the server.
SECRET_KEY=
DATABASE=/opt/eduflow/data/app.db
UPLOAD_FOLDER=/opt/eduflow/data/uploads
SERVER_SUBMISSION_ROOT=/opt/eduflow/data/server-files

TEACHERS=teacher01
TEACHER_GROUP=teacher
