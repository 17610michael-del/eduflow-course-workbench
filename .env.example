# Copy this file to .env and fill in private values on the server.
SECRET_KEY=
# 可选：独立的项目 Agent HMAC 密钥；留空时安全回退到 SECRET_KEY。
PROJECT_AGENT_TOKEN_SECRET=
COURSE_NAME=学位+
COURSE_SUBTITLE=193 内网服务器
COURSE_BADGE=CS
# 设为 degree 或 bioinformatics 可将该实例锁定为单门课程；留空启用课程切换。
COURSE_ONLY_SLUG=
# 仅用于新登录账号；迁移前已存在的账号会自动保留在“学位+”。双课学生需同时列入 DEGREE_USERS 和 BIOINFORMATICS_USERS。
DEGREE_USERS=
BIOINFORMATICS_USERS=
BIOINFORMATICS_ASSISTANTS=
BIO_UNDERGRAD_USERS=
BIO_UNDERGRAD_ASSISTANTS=
DATABASE=/opt/eduflow/data/app.db
UPLOAD_FOLDER=/opt/eduflow/data/uploads
SERVER_SUBMISSION_ROOT=/opt/eduflow/data/server-files

TEACHERS=teacher01
ASSISTANTS=
ALLOWED_USERS=teacher01
TEACHER_GROUP=teacher
ASSISTANT_GROUP=assistant

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_3066_MENU_ENABLED=0

HAPI_SERVER_HOST=10.98.103.193
HAPI_PORT_BASE=32000
HAPI_PUBLIC_URL_TEMPLATE=https://hapi-{username}.47.96.100.122.nip.io/

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
# 同一 IP 的不同端口必须使用不同 Cookie 名和登录提示前缀。
SESSION_COOKIE_NAME=eduflow_session
REMEMBER_COOKIE_NAME=eduflow_remember
LOGIN_HINT_COOKIE_PREFIX=eduflow_
# 仅演示环境设为 1；生产必须保持 0。
SEED_DEMO_DATA=0
