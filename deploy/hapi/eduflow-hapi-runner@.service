[Unit]
Description=EduFlow HAPI Runner for %i
After=network-online.target eduflow-hapi-hub@%i.service
Wants=network-online.target
Requires=eduflow-hapi-hub@%i.service

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/eduflow-hapi/%i.env
EnvironmentFile=-/etc/eduflow-ai/deepseek.env
Environment=HAPI_HOME=/home/%i/.hapi-runner
ExecStart=/data/kltst/homework/services/hapi/native/hapi runner start-sync --workspace-root /data/%i
Restart=always
RestartSec=10
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/data/%i
ReadWritePaths=-/home/%i/.hapi-runner
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
