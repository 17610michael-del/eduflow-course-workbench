[Unit]
Description=EduFlow isolated HAPI Hub for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=/etc/eduflow-hapi/%i.env
Environment=HAPI_HOME=/home/%i/.hapi-hub
ExecStart=/data/kltst/homework/services/hapi/native/hapi hub --no-relay
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/home/%i/.hapi-hub
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
